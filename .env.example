# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env dosyasını ASLA paylaşmayın / git'e eklemeyin.
#
# Testnet anahtarı: https://testnet.binancefuture.com  (config: testnet_kind: testnet)
#               veya https://demo.binance.com -> API Management (config: testnet_kind: demo)
# Gerçek anahtar:   binance.com -> API Management
#                   "Enable Futures" AÇIK, "Enable Withdrawals" KAPALI, IP kısıtlaması AÇIK.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Gerçek parayla işlem için bilinçli onay. "yes" yazmadıkça live mod çalışmaz.
ALLOW_LIVE=no

# (İsteğe bağlı) Telegram bildirimleri: işlem açılış/kapanış, devre kesici raporu
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
